# Copy to .env (gitignored) for local runs. The store's other settings —
# MONGODB_URI, ADMIN_PASSWORD, RAZORPAY_* and the rest — are listed in
# SETUP-AND-DEPLOY.md.

# Blog: posts arrive from the Befach Creatives app (SETUP-AND-DEPLOY.md, Part 5)
# Shared secret; the app signs every post with it. Unset = the webhook answers 503.
BLOG_WEBHOOK_SECRET=
# Public origin for blog links, canonical URLs and the sitemap (default https://dcal.co.in)
SITE_URL=
