# Copy to .env (gitignored) for local runs. The store's other settings —
# MONGODB_URI, ADMIN_PASSWORD, RAZORPAY_* and the rest — are listed in
# SETUP-AND-DEPLOY.md.

# Blog: posts arrive from the Befach Creatives app (SETUP-AND-DEPLOY.md, Part 5)
# Shared secret; the app signs every post with it. Unset = the webhook answers 503.
BLOG_WEBHOOK_SECRET=
# Public origin for blog links, canonical URLs and the sitemap (default https://dcal.co.in)
SITE_URL=

# Meta Conversions API (server/meta.js): the server's copy of every pixel event, Purchase included.
# Events Manager → pixel 2994497707552848 → Settings → Conversions API → Generate access token.
# Unset = the server sends nothing (the browser pixel still fires).
META_CAPI_TOKEN=
# While testing only: the code shown under Events Manager → Test events. Remove it afterwards.
META_TEST_EVENT_CODE=
# Defaults: META_PIXEL_ID=2994497707552848, META_GRAPH_VERSION=v26.0

# Orders export for the Demo Kit campaign (server/export.js): read only, its own key.
# Unset = /api/export answers 503.
EXPORT_API_KEY=
